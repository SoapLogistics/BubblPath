{
  "manifest_version": 3,
  "name": "Solomon Browser Companion",
  "version": "0.1.0",
  "description": "A persistent AI companion for research, safe shopping, and prediction markets.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Solomon"
  }
}
