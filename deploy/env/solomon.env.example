# ==============================================================================
# Solomon Environment Configuration Template (.env)
# Copy this file to /etc/solomon/solomon.env and configure appropriate values.
# NEVER commit a populated .env file to Git!
# ==============================================================================

# --- Authentication Configuration ---
# Set this to a highly secure, randomly generated API Key.
# Used by SolomonGPT to authenticate with SS1 Proxy and Backend.
SOLOMON_ACTIONS_API_KEY=REPLACE_WITH_SECURE_TOKEN_OUTSIDE_GIT

# --- Network & Service Routing Configuration ---
# Proxy exposes port 7420.
SOLOMON_PROXY_PORT=7420

# Python Backend binds to port 18789.
SOLOMON_API_BASE_URL=http://127.0.0.1:18789

# --- Project Mnemosyne (Memory Engine) Configuration ---
# Configurable database path on SS1 persistent storage.
SOLOMON_DB_PATH=/srv/storage/toshiba/BubblePath/data/mnemosyne/solomon_mnemosyne.db
SOLOMON_MEMORY_DEFAULT_CLEARANCE=INTERNAL
SOLOMON_MEMORY_RETRIEVAL_LIMIT=3

# --- LLM and OpenAI Configuration ---
# Recommended OpenAI model (e.g. gpt-4-turbo, gpt-3.5-turbo, etc.)
SOLOMON_MODEL=gpt-4-turbo
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY_OUTSIDE_GIT

# --- Observability & Log Level ---
SOLOMON_LOG_LEVEL=INFO
